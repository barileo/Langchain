import os
from dotenv import load_dotenv
from langchain_openai import OpenAIEmbeddings, ChatOpenAI
from langchain_pinecone import PineconeVectorStore


from langchain.memory import ConversationBufferMemory
from langchain.chains import ConversationalRetrievalChain

load_dotenv()

embedding = OpenAIEmbeddings()
llm = ChatOpenAI(model="gpt-4o")

vectorstore = PineconeVectorStore(index_name=os.environ.get("INDEX"), embedding=embedding)
retriever = vectorstore.as_retriever(search_kwargs={"k": 3})

# Memory: stores chat_history as a list of HumanMessage/AIMessage pairs
memory = ConversationBufferMemory(
    memory_key="chat_history",
    return_messages=True,      # returns Message objects (required by ConversationalRetrievalChain)
    output_key="answer"        # tells memory which output key to store
)

chain = ConversationalRetrievalChain.from_llm(
    llm=llm,
    retriever=retriever,
    memory=memory,
    return_source_documents=True,   # optional: see which docs were retrieved
    verbose=False
)


def chat(question: str) -> str:
    result = chain.invoke({"question": question})
    return result["answer"]


if __name__ == "__main__":
    print("Conversational RAG — type 'exit' to quit\n")

    while True:
        user_input = input("You: ").strip()
        if not user_input or user_input.lower() == "exit":
            break

        answer = chat(user_input)
        print(f"Bot: {answer}\n")